---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Pig Manure Fermentation Solution | GX-SANYU';
const description = 'Professional pig manure treatment solution using GX-SANYU aerobic fermentors. Convert pig waste into organic fertilizer with eco-friendly, energy-saving technology.';
const keywords = 'pig manure fermentation, pig waste treatment, pig farm fertilizer, aerobic fermentor for pig manure, hog waste management';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Pig Manure Fermentation Solution',
  provider: { '@type': 'Organization', name: 'GX-SANYU' },
  description,
  areaServed: 'Worldwide',
};

const benefits = [
  { title: 'Odor Elimination', text: 'Sealed fermentation system effectively contains and eliminates odors from pig waste.' },
  { title: 'Pathogen Reduction', text: 'High-temperature aerobic fermentation kills harmful pathogens in pig manure.' },
  { title: 'Revenue Generation', text: 'Convert waste into sellable organic fertilizer for additional farm income.' },
  { title: 'Regulatory Compliance', text: 'Meet environmental protection regulations for livestock waste discharge.' },
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header />
  <main id="main-content">
    <section class="solution-hero">
      <div class="shell">
        <span class="eyebrow" style="color:rgba(255,255,255,0.85);">Solutions</span>
        <h1>Pig Manure Fermentation Solution</h1>
        <p>Transform pig farm waste into high-value organic fertilizer with our proven aerobic fermentation technology. Designed for operations from 500 to 10,000+ head pig farms.</p>
        <div style="margin-top:28px; display:flex; gap:16px; flex-wrap:wrap;">
          <a class="button light" href="/products/gx-sanyu-11ffg-100">View the Fermentor</a>
          <a class="button" href="https://wa.me/8618477468950" target="_blank" rel="noopener" style="background:transparent; color:white; border-color:white;">Contact Sales Manager Bob</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell feature-split">
        <div>
          <img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=600&h=500&fit=crop" alt="Pig manure fermentation equipment" width="600" height="500" loading="lazy" decoding="async" />
        </div>
        <div>
          <span class="eyebrow">The Challenge</span>
          <h2>Sustainable Pig Waste Management</h2>
          <p>Pig farms generate significant organic waste that requires proper treatment to meet environmental standards. Traditional lagoon and composting methods are inefficient, odor-intensive, and take months to complete.</p>
          <p>GX-SANYU aerobic fermentors offer a modern, efficient alternative that processes pig manure in just 7 days with minimal odor and maximum nutrient retention.</p>
        </div>
      </div>
    </section>

    <section class="section usp-section">
      <div class="shell">
        <div class="section-heading">
          <span class="kicker">Key Benefits</span>
          <h2>Why Choose GX-SANYU for Pig Farms</h2>
        </div>
        <div class="usp-grid">
          {benefits.map((b) => (
            <article class="usp-card">
              <span class="usp-icon">✓</span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="feature-split">
      <div>
        <span class="eyebrow">Process</span>
        <h2>From Pig Waste to Organic Fertilizer</h2>
        <ul class="feature-list">
          <li>Pig manure (60% moisture) is loaded directly via forklift</li>
          <li>Aerobic bacteria decompose organic matter in 7 days</li>
          <li>Heat exchanger maintains optimal fermentation temperature</li>
          <li>Output: nutrient-rich organic fertilizer (30-40% moisture)</li>
          <li>Fertilizer can be sold or used on your own feed crops</li>
        </ul>
      </div>
      <div>
        <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=600&h=500&fit=crop" alt="Organic fertilizer production" width="600" height="500" loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="section cta-section">
      <div class="shell cta-box">
        <h2 style="color:white;">Need a Solution for Your Pig Farm?</h2>
        <p style="color:rgba(255,255,255,0.85); margin-bottom:24px;">We provide customized solutions based on your farm size, waste volume, and local regulations.</p>
        <a class="button light" href="https://wa.me/8618477468950" target="_blank" rel="noopener">Contact Sales Manager Bob</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
