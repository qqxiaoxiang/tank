---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'GX-SANYU 11FFG-100 Intelligent Aerobic Fermentor';
const description = 'GX-SANYU 11FFG-100 intelligent aerobic fermentor with 304 stainless steel construction, Mitsubishi PLC control, and patented heat exchanger. Converts 60%-moisture manure to 30-40% organic fertilizer in 7 days.';
const keywords = 'GX-SANYU 11FFG-100, aerobic fermentor, manure fermenter, organic fertilizer machine, compost tumbler, livestock waste treatment equipment';

const productData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'GX-SANYU 11FFG-100 Intelligent Aerobic Fermentor',
  image: 'https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=800&h=600&fit=crop',
  description,
  brand: { '@type': 'Brand', name: 'GX-SANYU' },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    url: Astro.site + '/products/gx-sanyu-11ffg-100',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '50',
  },
};

const specs = [
  { label: 'Model', value: 'GX-SANYU 11FFG-100' },
  { label: 'Type', value: 'Vertical Aerobic Fermentor' },
  { label: 'Capacity', value: '10 m³ / batch' },
  { label: 'Fermentation Cycle', value: '7 days average' },
  { label: 'Input Moisture', value: '60% (adjustable)' },
  { label: 'Output Moisture', value: '30-40%' },
  { label: 'Material', value: '304 Stainless Steel' },
  { label: 'Control System', value: 'Mitsubishi PLC' },
];

const features = [
  { title: 'Patented Heat Exchange System', text: 'Recovers fermentation heat to maintain optimal temperature, saving 46,000 kWh annually. Equivalent to 1,000 trees CO₂ absorption capacity.' },
  { title: '304 Stainless Steel Construction', text: 'Inner tank, main shaft, and blades all wrapped in 304 stainless steel. NACHI oil pump and ABB/Siemens motors ensure 10+ year lifespan.' },
  { title: 'Full Automation with Mitsubishi PLC', text: 'Centralized control panel with forklift loading, one-click remote operation, and comprehensive fault alarm system.' },
  { title: 'Vertical Space-Saving Design', text: 'Small footprint with large capacity. Continuous running system processes organic waste efficiently.' },
  { title: 'Advanced Deodorization', text: 'Equipped with spray tower water-washing deodorization system to effectively remove ammonia and other harmful gases.' },
  { title: 'Intelligent Monitoring', text: 'Real-time temperature, humidity, and fermentation progress monitoring with data logging.' },
];

const process = [
  { step: '01', title: 'Loading', desc: 'Forklift directly loads raw manure (60% moisture) into the fermentor tank' },
  { step: '02', title: 'Aerobic Fermentation', desc: 'Microorganisms decompose organic matter in a controlled aerobic environment over 7 days' },
  { step: '03', title: 'Heat Recovery', desc: 'Special heat exchanger recovers fermentation heat, maintaining temperature without external energy' },
  { step: '04', title: 'Discharge', desc: 'Fully fermented organic fertilizer (30-40% moisture) is discharged via the outlet' },
];
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productData)} />
  <Header />

  <main id="main-content">
    <!-- Product Hero -->
    <section class="product-hero" aria-labelledby="product-title">
      <div class="shell product-hero-grid">
        <div>
          <span class="eyebrow">Product Details</span>
          <h1 id="product-title">GX-SANYU 11FFG-100<br />Intelligent Aerobic Fermentor</h1>
          <p>An efficient environmental protection equipment developed in cooperation with Sanyu of Japan, featuring independent intellectual property rights. Converts organic solid waste into high-quality organic fertilizer through controlled aerobic fermentation.</p>
          <div class="product-specs">
            {specs.map((s) => (
              <div class="product-spec">
                <div class="spec-label">{s.label}</div>
                <div class="spec-value">{s.value}</div>
              </div>
            ))}
          </div>
          <div style="display:flex; gap:16px; flex-wrap:wrap;">
            <a class="button primary" href="https://wa.me/8618477468950" target="_blank" rel="noopener">Contact Sales Manager Bob</a>
            <a class="button secondary" href="/cases">See Real Cases</a>
          </div>
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=600&h=500&fit=crop" alt="GX-SANYU 11FFG-100 aerobic fermentor equipment" width="600" height="500" loading="eager" />
        </div>
      </div>
    </section>

    <!-- Key Features -->
    <section class="section" aria-labelledby="features-title">
      <div class="shell">
        <div class="section-heading">
          <span class="kicker">Key Features</span>
          <h2 id="features-title">Advanced Technology, Proven Performance</h2>
          <p>Designed for large-scale livestock farms requiring efficient, eco-friendly waste management solutions.</p>
        </div>
        <div class="usp-grid">
          {features.map((f, i) => (
            <article class="usp-card">
              <span class="usp-icon" aria-hidden="true">{['🌡️', '🛡️', '🤖', '📐', '💨', '📊'][i]}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section usp-section" aria-labelledby="process-title">
      <div class="shell">
        <div class="section-heading">
          <span class="kicker">How It Works</span>
          <h2 id="process-title">4-Step Fermentation Process</h2>
          <p>A closed-loop system that transforms organic waste into valuable organic fertilizer in just 7 days.</p>
        </div>
        <div class="usp-grid">
          {process.map((p) => (
            <article class="usp-card">
              <span class="usp-icon" style="color:var(--green); font:700 2rem var(--serif);">{p.step}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Eco Benefit -->
    <section class="feature-split">
      <div>
        <img src="https://images.unsplash.com/photo-1473448912268-2022ce9509d8?w=600&h=500&fit=crop" alt="Environmental benefits of aerobic fermentation" width="600" height="500" loading="lazy" decoding="async" />
      </div>
      <div>
        <span class="eyebrow">Environmental Impact</span>
        <h2>Save 46,000 kWh of Energy Every Year</h2>
        <p>Our patented heat exchanger uses fermentation heat to warm incoming fresh air, maintaining optimal internal temperature without oil or natural gas.</p>
        <ul class="feature-list">
          <li>Annual energy saving: 46,000 kWh (≈ 23,000 RMB/year at 0.5 RMB/kWh)</li>
          <li>CO₂ reduction equivalent to 1,000 pine trees growing for 40 years</li>
          <li>No external fuel needed — 100% waste-heat driven</li>
          <li>Primary dust removal function built-in</li>
        </ul>
      </div>
    </section>

    <!-- Durability -->
    <section class="feature-split reverse">
      <div>
        <span class="eyebrow">Industrial Reliability</span>
        <h2>Built to Last 10+ Years</h2>
        <p>Every component is engineered for harsh farm environments with 24/7 continuous operation in mind.</p>
        <ul class="feature-list">
          <li>Three-layer insulated tank design for temperature stability</li>
          <li>304 stainless steel on all manure-contact surfaces</li>
          <li>NACHI hydraulic oil pump — Japanese precision</li>
          <li>ABB / Siemens grade motors for reliable long-term operation</li>
          <li>Main shaft and blades fully wrapped in stainless steel</li>
        </ul>
      </div>
      <div>
        <img src="https://images.unsplash.com/photo-1581093588401-fbb62a02f120?w=600&h=500&fit=crop" alt="Industrial-grade stainless steel construction" width="600" height="500" loading="lazy" decoding="async" />
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section">
      <div class="shell cta-box">
        <h2 style="color:white;">Ready to Buy or Need More Info?</h2>
        <p style="color:rgba(255,255,255,0.85); max-width:560px; margin:0 auto 24px;">Contact us for detailed specifications, pricing, installation guidance, and shipping arrangements worldwide.</p>
        <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
          <a class="button light" href="https://wa.me/8618477468950" target="_blank" rel="noopener">Contact Sales Manager Bob</a>
          <a class="button" href="/aerobic-fermentor-vs-dryer" style="background:transparent; color:white; border-color:white;">Aerobic Fermentor vs Dryer</a>
          <a class="button" href="/faq" style="background:transparent; color:white; border-color:white;">Read FAQ</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
