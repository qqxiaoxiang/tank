---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Terms of Service | GX-SANYU';
const description = 'GX-SANYU Terms of Service. Please read these terms carefully before using our website or services.';
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <section class="legal-section">
      <div class="shell">
        <h1>Terms of Service</h1>
        <p>Last updated: August 2026</p>

        <p>Welcome to GX-SANYU. By accessing our website and services, you agree to the following terms. Please read these carefully.</p>

        <h2>Use of Website</h2>
        <p>You agree to use our website lawfully and responsibly. You may not:</p>
        <ul>
          <li>Use the site for any unlawful purpose</li>
          <li>Attempt to gain unauthorized access to any part of the site</li>
          <li>Interfere with the proper functioning of the site</li>
          <li>Use automated systems to access or interact with the site</li>
        </ul>

        <h2>Intellectual Property</h2>
        <p>All content on this website, including text, images, logos, product specifications, and design, is the property of GX-SANYU or its content suppliers. Reproduction, distribution, or commercial use without written permission is prohibited.</p>

        <h2>Product Information</h2>
        <p>We strive to provide accurate product information. However, specifications, features, and pricing may change without notice. All product information on this website is for general reference only.</p>

        <h2>Quotations and Orders</h2>
        <p>All product inquiries and orders are subject to formal quotation and acceptance. Prices, lead times, and specifications are confirmed at the time of quotation.</p>

        <h2>Limitation of Liability</h2>
        <p>While we use reasonable care in maintaining our website and information, we make no warranties about the accuracy, completeness, or reliability of the content. We are not liable for any indirect or consequential losses.</p>

        <h2>Governing Law</h2>
        <p>These terms are governed by applicable laws. Any disputes will be resolved through appropriate legal channels.</p>

        <h2>Changes to Terms</h2>
        <p>We may update these terms from time to time. Changes will be posted on this page. Your continued use of our website constitutes acceptance of the updated terms.</p>

        <h2>Contact</h2>
        <p>For questions about these Terms of Service, please contact us at: <a href="/contact">Contact Page</a></p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
