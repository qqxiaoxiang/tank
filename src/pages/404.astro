---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page Not Found" description="The page you are looking for does not exist.">
  <Header />
  <main id="main-content">
    <section class="about-hero">
      <div class="shell not-found">
        <h1>404</h1>
        <h2>Page Not Found</h2>
        <p>The page you are looking for does not exist or has been moved. Let us help you find your way back.</p>
        <a class="button primary" href="/">Back to Home</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
